{
  "name": "botbinance",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "start": "cross-env  node server.js",
    "build": "next build",
    "build:electron": "electron-builder",
    "dev": "node server.js",
    "lint": "eslint",
    "electron": "electron ./electron/main.js"
  },
  "build": {
    "asarUnpack": [
      ".next/**/*"
    ],
    "appId": "com.overfox.botbinance",
    "productName": "Overfox Bot",
    "files": [
      "electron/**/*",
      ".next/**/*",
      "node_modules/**/*",
      "dist/**/*",
      "bot/**/*",
      "package.json"
    ],
    "mac": {
      "target": "dmg"
    }
  },
  "dependencies": {
    "@emotion/react": "^11",
    "@emotion/styled": "^11",
    "@hugeicons-pro/core-duotone-standard": "^3.1.0",
    "@hugeicons-pro/core-solid-rounded": "^4.0.0",
    "@hugeicons-pro/core-solid-standard": "^3.1.0",
    "@hugeicons-pro/core-stroke-rounded": "^3.1.0",
    "@hugeicons-pro/core-stroke-sharp": "^3.3.0",
    "@hugeicons-pro/core-stroke-standard": "^3.1.0",
    "@hugeicons/react": "^1.1.4",
    "@mui/icons-material": "^7",
    "@mui/material": "^7",
    "@mui/material-nextjs": "^7",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@toolpad/core": "0.16.0",
    "axios": "^1.13.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "detect-port": "^2.1.0",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "jspdf": "^4.2.0",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^0.562.0",
    "mongoose": "^9.1.5",
    "next": "16.1.1",
    "next-auth": "5.0.0-beta.25",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "^3.4.0",
    "xlsx": "^0.18.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "40.0.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "nodemon": "^3.1.11",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "wait-on": "^9.0.3"
  }
}
